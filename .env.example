# Copy to .env (git-ignored). Values here are placeholders for LOCAL development only.
# Never put real credentials in this file.

# ---- PostgreSQL (compose) ----
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
CORE_MIGRATOR_PASSWORD=change-me-core-migrator
CORE_APP_PASSWORD=change-me-core-app
CORE_PLATFORM_PASSWORD=change-me-core-platform
GAME_MIGRATOR_PASSWORD=change-me-game-migrator
GAME_APP_PASSWORD=change-me-game-app
ATHLETE_MIGRATOR_PASSWORD=change-me-athlete-migrator
ATHLETE_APP_PASSWORD=change-me-athlete-app

# ---- Keycloak (compose) ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KC_DB_PASSWORD=change-me-keycloak-db
# nginx blocks the Keycloak admin console and the master realm (403) unless true; the e2e suite needs true
# (master-realm admin-cli token + Admin API). Takes effect on `just down && just up`.
HOOPS_EXPOSE_KC_ADMIN=false
# Confidential clients used by services for /internal calls (service accounts)
CORE_SERVICE_CLIENT_SECRET=change-me-core-client
GAME_SERVICE_CLIENT_SECRET=change-me-game-client
ATHLETE_SERVICE_CLIENT_SECRET=change-me-athlete-client

# ---- kind: password of the rate limit service's Redis user (ACL, ADR-0033; deploy/kind/secrets.sh) ----
RATELIMIT_REDIS_PASSWORD=change-me-ratelimit-redis

# ---- kind: event broker logins (Redpanda SASL/SCRAM, ADR-0036; deploy/kind/secrets.sh). Compose's Redpanda has no auth ----
REDPANDA_ADMIN_PASSWORD=change-me-redpanda-admin
REDPANDA_CORE_SERVICE_PASSWORD=change-me-redpanda-core
REDPANDA_GAME_SERVICE_PASSWORD=change-me-redpanda-game
REDPANDA_ATHLETE_SERVICE_PASSWORD=change-me-redpanda-athlete

# ---- game / athlete roster source (ADR-0037; WP98): both read their replica of core's roster by default. Uncomment to
# fall back to core's /internal API (one setting per service and a restart; nothing is lost). ----
# GAME_ROSTER_SOURCE=rest
# ATHLETE_ROSTER_SOURCE=rest

# ---- Dev users seeded by infra/keycloak/seed-users.sh (local only) ----
DEV_USER_PASSWORD=change-me-dev-users

# ---- Test academy (WP103): `just seed-academy` ----
# Shared final password (>= 12 characters) of all test logins; the script sets it in Keycloak on every run.
TEST_ACADEMY_PASSWORD=change-me-test-academy
# The script sets TEST_ACADEMY_USERS=<comma-separated logins> in .env. Logins (<name>@hoops-academy.com):
#   testadmin1, testadmin2 (ADMIN), testcoach1 (COACH), testassistant1 (ASSISTANT_COACH), testplayer1..testplayer10 (PLAYER),
#   it also fills the academy with demo data like the landing pictures (SEED_ACADEMY_DEMO=0 skips it),
#   testparentplayer1..testparentplayer10 (PARENT; parent N is the guardian of player N)

# ---- Public URLs ----
PUBLIC_BASE_URL=http://localhost:8080

# ---- core-service mail (WP90, ADR-0044): the decision e-mails of academy requests ----
# Defaults reach compose's MailHog (localhost:1025, no TLS, no login); a real server needs all of these.
SMTP_HOST=localhost
SMTP_PORT=1025
# DISABLED | OPTIONAL | REQUIRED (use REQUIRED with a real server)
SMTP_START_TLS=OPTIONAL
SMTP_USERNAME=
# secret of a real server (empty for MailHog); never commit a value
SMTP_PASSWORD=
MAIL_FROM="Hoops Academy <no-reply@hoops.localhost>"
# Base URL in the mails' sign-in link (the browser's address of the app)
HOOPS_PUBLIC_URL=http://localhost:8080

# OWASP dependency-check NVD API key (https://nvd.nist.gov/developers/request-an-api-key): `just scan` passes it to
# dependency-check when set; CI uses the GitHub secret of the same name
NVD_API_KEY=
