# --- secrets: never commit ---
.env
.env.*
!.env.example
*-secret*.yaml
*-secrets*.yaml
values-local.yaml
*.pem
*.p12
*.jks
*.key
infra/keycloak/*credentials*
# OpenTofu (WP104, ADR-0050): state, plans, variable files, the provider cache and crash logs; the lock file is committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# --- java / maven ---
target/
*.class
*.log
.mvn/wrapper/maven-wrapper.jar
dependency-check-report.*

# --- flutter / dart ---
apps/web/.dart_tool/
apps/web/build/
apps/web/.flutter-plugins*
apps/web/.packages
apps/web/pubspec.lock.bak
apps/web/packages/*/.dart_tool/
apps/web/packages/*/build/
apps/web/packages/*/.openapi-generator/
apps/web/packages/*/pubspec.lock
apps/web/test/golden/failures/
apps/web/coverage/

# --- tooling ---
.idea/
*.iml
.vscode/
.DS_Store
.tilt-cache/
tilt_modules/
.pre-commit-cache/
*.swp
# Python bytecode of the scripts and their tests (scripts/, scripts/tests)
__pycache__/
# virtualenv of the documentation site (just docs-serve / docs-build)
.venv-docs/
/tmp/
# per-machine Claude Code permissions
.claude/settings.local.json
# Semgrep registry rulesets fetched by scripts/semgrep-rules.sh (semgrep workflow)
semgrep-registry/
