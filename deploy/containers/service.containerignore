# Context filter for service.Containerfile with APP_SOURCE=maven (repository root is the context).
# Re-include each directory itself as well as its contents (buildah matches the directory first).
**
!pom.xml
!.mvn
!.mvn/wrapper
!.mvn/wrapper/maven-wrapper.properties
!libs
!libs/**
!services
!services/**
!e2e
!e2e/pom.xml
**/target
# The Rust and Go services are not Maven modules (ADR-0051): their sources would only invalidate the Maven layer.
services/pdf-service
services/finance-service
**/.idea
**/*.iml
**/.DS_Store
