# Developer entry points. Run `just` to list.
set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-load := true

default:
    @just --list

# Verify toolchain
doctor:
    source scripts/env.sh && scripts/doctor.sh

# Build and run all backend tests (unit + integration) with quality gates
test:
    source scripts/env.sh && ./mvnw -q -T 1C verify

# Gate before Claude's git commit: academy A logs in through real Keycloak and tries to read academy B (API + database)
isolation-check:
    scripts/hooks/isolation-check.sh

# Gate before Claude's git push: every service connects as a role RLS binds (not owner, superuser or BYPASSRLS)
db-role-check:
    scripts/hooks/db-role-check.sh

# Offline tests: the tenancy hook's command matcher, the doctor's Podman drop-in step (stubbed) and the pin scripts
test-hooks:
    scripts/hooks/tenancy-gate.test.sh
    scripts/tests/doctor-podman-dropin.test.sh
    python3 -I -m unittest discover -s scripts/tests

# Fast compile + unit tests only
unit:
    source scripts/env.sh && ./mvnw -q -T 1C test

# Mutation testing on demand (docs/quality/mutation.md): PIT on one module's rule code, or on every configured module
# in turn; fails below the module's baseline. Reports in <module>/target/pit-reports. MODULE: an artifactId or "all"
mutation MODULE="all":
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/env.sh
    modules="{{MODULE}}"
    if [ "$modules" = all ]; then modules="common-quarkus core-service game-service athlete-service"; fi
    for module in $modules; do
      start=$SECONDS
      ./mvnw -B -ntp -Dmutation="$module" -pl ":$module" -am test-compile org.pitest:pitest-maven:mutationCoverage
      echo "mutation $module: $((SECONDS - start)) s"
    done

# Mutation testing of the web rule code (docs/quality/mutation.md): a Dart script (tool/mutation/run.dart) mutates the
# files of tool/mutation/manifest.json and runs their flutter tests per mutant; fails below the manifest's baseline.
# Report in apps/web/build/mutation/report.json. ARGS: e.g. --workers 2, --target lib/<file>.dart, --list
web-mutation *ARGS:
    cd apps/web && flutter pub get >/dev/null && dart run tool/mutation/run.dart {{ARGS}}

# Regenerate the Mermaid ER and class diagrams of docs/domain/*-model.md (throwaway PostgreSQL via Podman, ~10 s)
diagrams:
    scripts/model-diagrams.sh

# Fail with a diff when docs/domain/*-model.md are stale against the migrations and sources (CI runs this)
diagrams-check:
    scripts/model-diagrams.sh --check

# Start the local stack (Postgres, Keycloak, proxy, mail, Redpanda + its topics)
up:
    podman compose --env-file .env -f infra/compose/compose.yaml up -d --wait
    just events-topics

# Event topics on the local Redpanda (idempotent; ADR-0036). `just up` runs it.
events-topics:
    infra/compose/redpanda-topics.sh

# Rebuild a service's roster replica from the topics (ADR-0037; stop the service first): just events-replay game
events-replay SERVICE:
    infra/compose/events-replay.sh {{SERVICE}}

# Publish core's roster aggregates that have no event yet (WP81; idempotent): just events-backfill [<tenant-id>] [force]
events-backfill *ARGS:
    infra/compose/events-backfill.sh {{ARGS}}

down:
    podman compose --env-file .env -f infra/compose/compose.yaml down

logs *ARGS:
    podman compose --env-file .env -f infra/compose/compose.yaml logs -f {{ARGS}}

# Seed Keycloak dev users (needs stack up)
seed-users:
    infra/keycloak/seed-users.sh

# Regenerate Dart API clients from libs/contracts
gen-api:
    scripts/gen-api.sh

# Flutter tests
web-test:
    cd apps/web && flutter test

# format apps/web (default 80 columns); packages/* are generated by gen-api and excluded
web-format:
    cd apps/web && dart format lib test integration_test tool

web-format-check:
    cd apps/web && dart format --output=none --set-exit-if-changed lib test integration_test tool

# Security: secrets scan (full history) and dependency check. NVD_API_KEY from .env (dotenv-load) speeds up the NVD
# update like CI's secret does; without it dependency-check warns and the first update takes very long.
scan:
    gitleaks detect --source . --redact
    source scripts/env.sh && ./mvnw -q -Psecurity-scan org.owasp:dependency-check-maven:aggregate \
      ${NVD_API_KEY:+-DnvdApiKey="$NVD_API_KEY"}

# kind cluster lifecycle (WP16, WP36): cluster + Envoy Gateway + CNPG + namespace/secrets. ARGS: --deploy [--from-host]
kind-up *ARGS:
    deploy/kind/up.sh {{ARGS}}

kind-down:
    deploy/kind/down.sh

# Inner loop on kind (needs `just kind-up`). ARGS go to Tilt, e.g. `just tilt ci` or `just tilt up -- --from-host`
tilt *ARGS="up":
    source scripts/env.sh && tilt {{ARGS}}

# --- WP18: end-to-end journeys (docs/runbooks/e2e.md) ---

# Build + start core/game/athlete on 8081-8083 against the running compose stack (needs `just up`, `just seed-users`)
services-up:
    e2e/bin/services-up.sh

services-down:
    e2e/bin/services-down.sh

# Whole journey suite on compose: stack up, seed users, services up, run, services down (stack stays up). BASE defaults to :8080
e2e BASE="http://localhost:8080":
    just up
    just seed-users
    e2e/bin/services-up.sh
    source scripts/env.sh && ./mvnw -pl e2e test -De2e.baseUrl={{BASE}}; rc=$?; e2e/bin/services-down.sh; exit $rc
