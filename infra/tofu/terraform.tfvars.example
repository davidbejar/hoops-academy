# Copy to terraform.tfvars (git-ignored) and replace the placeholders. Never put a credential or the state passphrase in
# this file: the access key comes from ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET and the passphrase from
# TF_VAR_state_passphrase (docs/runbooks/cloud.md, step 1).

# Your public IPv4 address as /32 (curl -s https://checkip.amazonaws.com). SSH and the Kubernetes API are reachable from
# these CIDRs only; anything wider than /16 is refused.
admin_cidrs = ["203.0.113.10/32"]

# One line of your OpenSSH public key (~/.ssh/id_ed25519.pub). Never the private key.
ssh_public_key = "ssh-ed25519 AAAA...replace-with-your-public-key... you@laptop"

# Optional, with their defaults:
# region               = "ap-southeast-5"   # Indonesia (Jakarta); never a mainland China region
# instance_type        = "ecs.g7.large"     # 2 vCPU, 8 GiB; the plan fails below 8 GiB or if the region does not sell it
# system_disk_category = "cloud_essd"
# system_disk_size_gib = 60
# eip_bandwidth_mbps   = 10
# dns_suffix           = "sslip.io"         # or nip.io
# name                 = "hoops"
# tags                 = { owner = "you" }
