<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hoopsacademy</groupId>
    <artifactId>hoops-academy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>game-service</artifactId>
  <name>Hoops Academy :: game-service</name>
  <description>Matches, match rosters and (WP7) offline-first match events and statistics</description>

  <properties>
    <!-- mutation testing (WP37, docs/quality/mutation.md): the rule code PIT mutates and the pure unit tests it may
         run; MutationScopeTest fails the default build if a container test ever falls under these test globs -->
    <pit.targetClasses>com.hoopsacademy.game.domain.*,com.hoopsacademy.game.application.EventAuthorization*,com.hoopsacademy.game.application.StatVisibility*,com.hoopsacademy.game.application.replica.ReplicaRosterPort*,com.hoopsacademy.game.application.replica.ReplicaPlayer*,com.hoopsacademy.game.application.replica.ReplicaTenant*,com.hoopsacademy.game.application.replica.ReplicaAcademyNames*,com.hoopsacademy.game.application.EventAdmission*,com.hoopsacademy.game.application.EventLedger*,com.hoopsacademy.game.application.VoidMarks*,com.hoopsacademy.game.adapters.in.rest.MatchEventDecoder*,com.hoopsacademy.game.adapters.in.messaging.RosterEventMapper*,com.hoopsacademy.game.adapters.in.rest.AcceptLanguage*,com.hoopsacademy.game.application.sheet.MatchSheets*</pit.targetClasses>
    <pit.targetTests>com.hoopsacademy.game.domain.*,com.hoopsacademy.game.application.EventAuthorizationTest*,com.hoopsacademy.game.application.StatVisibilityTest*,com.hoopsacademy.game.application.replica.ReplicaRosterPortTest*,com.hoopsacademy.game.application.replica.ReplicaAcademyNamesTest*,com.hoopsacademy.game.application.EventAdmissionTest*,com.hoopsacademy.game.application.EventLedgerTest*,com.hoopsacademy.game.application.VoidMarksTest*,com.hoopsacademy.game.adapters.in.rest.MatchEventDecoderTest*,com.hoopsacademy.game.adapters.in.messaging.RosterEventMapperTest*,com.hoopsacademy.game.adapters.in.rest.AcceptLanguageTest*,com.hoopsacademy.game.application.sheet.MatchSheetsTest*</pit.targetTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>common-quarkus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-narayana-jta</artifactId>
    </dependency>
    <!-- replica housekeeping (WP82): the daily retention job; version from the Quarkus BOM -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-scheduler</artifactId>
    </dependency>
    <!-- roster replica (WP68, ADR-0037): Kafka consumer of core's roster topics on Redpanda; version from the Quarkus BOM -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging-kafka</artifactId>
    </dependency>
    <!-- events/match-event.schema.json is read from the contracts jar at runtime (per-event validation) -->
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>contracts</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!-- ===== test ===== -->
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>common-quarkus</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-restassured</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security-oidc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- RosterBrokerResource: the pinned Redpanda image started through ContainerStarts (WP82); BOM version -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- just mutation game-service (or -Pmutation): PIT on the rule code above; fails below the recorded baseline -->
    <profile>
      <id>mutation</id>
      <activation>
        <property><name>mutation</name><value>game-service</value></property>
      </activation>
      <properties>
        <pit.skip>false</pit.skip>
        <!-- baseline (docs/quality/mutation.md): 99.6 % (525/527) on 2026-11-10 (WP98); 99.6 % (551/553) on 2026-11-24
             (WP130: RosterEventMapper replaces RosterEventDecoder); the score rounded down to a whole percent -->
        <pit.mutationThreshold>99</pit.mutationThreshold>
      </properties>
    </profile>
  </profiles>
</project>
