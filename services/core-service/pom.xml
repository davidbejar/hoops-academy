<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hoopsacademy</groupId>
    <artifactId>hoops-academy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>core-service</artifactId>
  <name>Hoops Academy :: core-service</name>
  <description>Tenancy, identity &amp; membership, platform endpoints, tenant profile and logo, roster &amp; eligibility</description>

  <properties>
    <!-- DoD: >= 80 % lines for the module, >= 90 % for the domain packages -->
    <jacoco.line.minimum>0.80</jacoco.line.minimum>
    <jacoco.domain.line.minimum>0.90</jacoco.domain.line.minimum>
    <!-- not managed by the parent / Quarkus BOM -->
    <assertj.version>3.27.7</assertj.version>
    <wiremock.version>3.13.2</wiremock.version>
    <!-- same line as libs/contracts and game-service (Jackson 2) -->
    <json-schema-validator.version>2.0.8</json-schema-validator.version>
    <!-- tests tagged "keycloak" need a Keycloak container: run with -Pkeycloak-it -->
    <surefire.excludedGroups>keycloak</surefire.excludedGroups>
    <surefire.groups></surefire.groups>
    <!-- mutation testing (WP37, docs/quality/mutation.md): the rule code PIT mutates and the pure unit tests it may
         run; MutationScopeTest fails the default build if a container test ever falls under these test globs -->
    <pit.targetClasses>com.hoopsacademy.core.domain.*,com.hoopsacademy.core.application.members.LoginProvisioning*,com.hoopsacademy.core.application.members.TemporaryPasswordGenerator*,com.hoopsacademy.core.application.authz.AuthzCache*,com.hoopsacademy.core.application.audit.AuditActorKind*,com.hoopsacademy.core.application.port.AuditFilter*,com.hoopsacademy.core.application.port.AuditAction*,com.hoopsacademy.core.application.events.EventTopic*,com.hoopsacademy.core.application.events.RosterPayloads*,com.hoopsacademy.core.application.events.RosterEventAppender*,com.hoopsacademy.core.application.events.EventEnvelopes*,com.hoopsacademy.core.application.events.TenantEvents*,com.hoopsacademy.core.adapters.out.events.KafkaEventBroker*,com.hoopsacademy.core.application.events.BackfillPlan*,com.hoopsacademy.core.application.signup.DecideAcademyRequest*,com.hoopsacademy.core.application.shared.ChangedFields*,com.hoopsacademy.core.application.audit.AuditEntry*,com.hoopsacademy.core.adapters.in.shared.PatchBody*,com.hoopsacademy.core.adapters.in.export.*,com.hoopsacademy.core.application.export.ExportPages*</pit.targetClasses>
    <pit.targetTests>com.hoopsacademy.core.domain.*,com.hoopsacademy.core.application.members.LoginProvisioningTest*,com.hoopsacademy.core.application.members.TemporaryPasswordGeneratorTest*,com.hoopsacademy.core.application.authz.AuthzCacheTest*,com.hoopsacademy.core.application.audit.AuditActorKindTest*,com.hoopsacademy.core.application.port.AuditFilterTest*,com.hoopsacademy.core.application.port.AuditActionCompletenessTest*,com.hoopsacademy.core.application.events.EventTopicTest*,com.hoopsacademy.core.application.events.RosterEventAppenderTest*,com.hoopsacademy.core.application.events.EventEnvelopesTest*,com.hoopsacademy.core.adapters.out.events.KafkaEventBrokerTest*,com.hoopsacademy.core.application.events.BackfillPlanTest*,com.hoopsacademy.core.application.signup.DecideAcademyRequestTest*,com.hoopsacademy.core.application.shared.ChangedFieldsTest*,com.hoopsacademy.core.application.audit.AuditEntryTest*,com.hoopsacademy.core.adapters.in.shared.PatchBodyTest*,com.hoopsacademy.core.adapters.in.export.*,com.hoopsacademy.core.application.export.ExportPagesTest*</pit.targetTests>
  </properties>

  <dependencies>
    <!-- ===== runtime ===== -->
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>common-quarkus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-keycloak-admin-rest-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-scheduler</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- outbox publisher (WP67, ADR-0036): a plain Kafka producer to Redpanda that core can replace (WP81), with the
         kafka.* configuration and Dev Services Redpanda; version from the Quarkus BOM -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-kafka-client</artifactId>
    </dependency>
    <!-- decision e-mails of academy requests (WP90, ADR-0044): SMTP from the environment, plain-text Qute templates;
         versions from the Quarkus BOM -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-mailer</artifactId>
    </dependency>

    <!-- ===== test ===== -->
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>common-quarkus</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>contracts</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the outbox payloads and published events are validated against libs/contracts/events (WP67) -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-restassured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security-oidc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- a SASL/SCRAM broker of the pinned Redpanda image whose users appear after core started (WP81); BOM version -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>${surefire.groups}</groups>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <configuration>
              <!-- classes loaded by Quarkus are instrumented by quarkus-jacoco into the same data file -->
              <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
              <append>true</append>
            </configuration>
          </execution>
          <execution>
            <id>check</id>
            <configuration>
              <rules combine.children="append">
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.hoopsacademy.core.domain*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.domain.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- just mutation core-service (or -Pmutation): PIT on the rule code above; fails below the recorded baseline -->
    <profile>
      <id>mutation</id>
      <activation>
        <property><name>mutation</name><value>core-service</value></property>
      </activation>
      <properties>
        <pit.skip>false</pit.skip>
        <!-- baseline (docs/quality/mutation.md): 99.9 % (777/778) on 2026-11-07 (WP88), the score rounded down to a whole
             percent -->
        <pit.mutationThreshold>99</pit.mutationThreshold>
        <!-- equivalent: TemporaryPassword.hashCode only has to agree with equals; any constant (PIT's 0) does -->
        <pit.excludedMethods>hashCode</pit.excludedMethods>
      </properties>
    </profile>
    <!-- ./mvnw -pl services/core-service verify -Pkeycloak-it : runs ONLY the @Tag("keycloak") tests -->
    <profile>
      <id>keycloak-it</id>
      <properties>
        <surefire.groups>keycloak</surefire.groups>
        <surefire.excludedGroups></surefire.excludedGroups>
        <jacoco.skip>true</jacoco.skip>
      </properties>
    </profile>
  </profiles>
</project>
