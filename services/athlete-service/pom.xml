<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hoopsacademy</groupId>
    <artifactId>hoops-academy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>athlete-service</artifactId>
  <name>Hoops Academy :: athlete-service</name>
  <description>Training schedules, sessions, attendance, planned absences (health and fitness follow in WP9/WP10)</description>

  <properties>
    <!-- not managed by the parent / Quarkus BOM -->
    <assertj.version>3.27.7</assertj.version>
    <wiremock.version>3.13.2</wiremock.version>
    <json-schema-validator.version>2.0.8</json-schema-validator.version>
    <!-- mutation testing (WP37, docs/quality/mutation.md): the rule code PIT mutates and the pure unit tests it may
         run; MutationScopeTest fails the default build if a container test ever falls under these test globs -->
    <pit.targetClasses>com.hoopsacademy.athlete.domain.*,com.hoopsacademy.athlete.application.replica.ApplyRosterEvent*,com.hoopsacademy.athlete.application.replica.RosterChange*,com.hoopsacademy.athlete.application.replica.RosterTopic*,com.hoopsacademy.athlete.adapters.in.messaging.CoreEventDecoder*,com.hoopsacademy.athlete.adapters.in.rest.AcceptLanguage*,com.hoopsacademy.athlete.adapters.in.rest.PatchBody*,com.hoopsacademy.athlete.adapters.config.RosterSource,com.hoopsacademy.athlete.adapters.config.RosterSource$*</pit.targetClasses>
    <pit.targetTests>com.hoopsacademy.athlete.domain.*,com.hoopsacademy.athlete.application.replica.ApplyRosterEventRulesTest*,com.hoopsacademy.athlete.adapters.in.messaging.CoreEventDecoderTest*,com.hoopsacademy.athlete.adapters.in.rest.AcceptLanguageTest*,com.hoopsacademy.athlete.adapters.in.rest.PatchBodyTest*,com.hoopsacademy.athlete.adapters.config.RosterSourceTest*</pit.targetTests>
    <!-- tests tagged "keycloak" need a Keycloak container: run with -Pkeycloak-it -->
    <surefire.excludedGroups>keycloak</surefire.excludedGroups>
    <surefire.groups></surefire.groups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>common-quarkus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc-client</artifactId>
    </dependency>
    <!-- /q/health/live|ready|started for Kubernetes probes (datasource readiness + core reachability data) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-scheduler</artifactId>
    </dependency>
    <!-- WP69 (ADR-0036/0037): the roster replica consumes core's events from Redpanda -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging-kafka</artifactId>
    </dependency>
    <!-- every event is validated against libs/contracts events/core.<aggregate>.schema.json, read from the jar -->
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>contracts</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
    </dependency>

    <!-- ===== test ===== -->
    <dependency>
      <groupId>com.hoopsacademy</groupId>
      <artifactId>common-quarkus</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-restassured</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security-oidc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- RosterBrokerResource: the pinned Redpanda image started through ContainerStarts (WP82); BOM version -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>${surefire.groups}</groups>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <configuration>
              <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
              <append>true</append>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- just mutation athlete-service (or -Pmutation): PIT on the rule code above; fails below the recorded baseline -->
    <profile>
      <id>mutation</id>
      <activation>
        <property><name>mutation</name><value>athlete-service</value></property>
      </activation>
      <properties>
        <pit.skip>false</pit.skip>
        <!-- baseline (docs/quality/mutation.md): 100 % (690/690) on 2026-11-10 (WP98), the score rounded down to a whole
             percent -->
        <pit.mutationThreshold>100</pit.mutationThreshold>
      </properties>
    </profile>
    <!-- ./mvnw -pl services/athlete-service verify -Pkeycloak-it : runs ONLY the @Tag("keycloak") tests -->
    <profile>
      <id>keycloak-it</id>
      <properties>
        <surefire.groups>keycloak</surefire.groups>
        <surefire.excludedGroups></surefire.excludedGroups>
        <jacoco.skip>true</jacoco.skip>
      </properties>
    </profile>
  </profiles>
</project>
