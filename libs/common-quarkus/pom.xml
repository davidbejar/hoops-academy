<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hoopsacademy</groupId>
    <artifactId>hoops-academy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>common-quarkus</artifactId>
  <name>Hoops Academy :: common-quarkus</name>
  <description>Tenancy, RLS, authz, Problem+JSON and shared test fixtures</description>

  <properties>
    <!-- WP2a acceptance: module coverage gate -->
    <jacoco.line.minimum>0.85</jacoco.line.minimum>
    <!-- not managed by the parent / Quarkus BOM -->
    <assertj.version>3.27.7</assertj.version>
    <!-- mutation testing (WP37, docs/quality/mutation.md): the rule code PIT mutates and the pure unit tests it may
         run; MutationScopeTest fails the default build if a container test ever falls under these test globs -->
    <pit.targetClasses>com.hoopsacademy.common.tenancy.TenantId*,com.hoopsacademy.common.tenancy.TenantContext*,com.hoopsacademy.common.tenancy.AuthzContext*,com.hoopsacademy.common.problem.Problem,com.hoopsacademy.common.problem.Problem$*,com.hoopsacademy.common.problem.ProblemType*,com.hoopsacademy.common.client.CoreRosterClient*,com.hoopsacademy.common.client.RosterAuthzResolver*,com.hoopsacademy.common.client.TenantHeaderPropagationFilter*,com.hoopsacademy.common.client.ServiceTokenClientFilter*,com.hoopsacademy.common.security.AuthzDenial,com.hoopsacademy.common.security.AuthzDenial$*,com.hoopsacademy.common.security.DenialKind*,com.hoopsacademy.common.security.TokenFailureReason*,com.hoopsacademy.common.tenancy.ExclusiveLocks*,com.hoopsacademy.common.tenancy.TenantScopedPaths*,com.hoopsacademy.common.problem.ProblemMapping*</pit.targetClasses>
    <pit.targetTests>com.hoopsacademy.common.tenancy.TenantIdTest*,com.hoopsacademy.common.tenancy.TenantContextTest*,com.hoopsacademy.common.tenancy.AuthzContextTest*,com.hoopsacademy.common.problem.ProblemTest*,com.hoopsacademy.common.client.CoreRosterClientTest*,com.hoopsacademy.common.client.RosterAuthzResolverTest*,com.hoopsacademy.common.client.TenantHeaderPropagationFilterTest*,com.hoopsacademy.common.client.ServiceTokenClientFilterTest*,com.hoopsacademy.common.security.AuthzDenialTest*,com.hoopsacademy.common.security.TokenFailureReasonTest*,com.hoopsacademy.common.tenancy.ExclusiveLocksTest*,com.hoopsacademy.common.tenancy.TenantScopedPathsTest*,com.hoopsacademy.common.problem.ProblemMappingTest*</pit.targetTests>
  </properties>

  <dependencies>
    <!-- ===== runtime (main jar) ===== -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc-client</artifactId>
    </dependency>
    <!-- shared core-service /internal client (CoreInternalClient, CoreRosterClient) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- readiness: CoreReachabilityCheck (game, athlete); every service also gets /q/health/live|ready -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <!-- observability for every service (ADR-0017): Prometheus /q/metrics, OpenTelemetry traces (SDK disabled by
         default, see microprofile-config.properties), JSON console logs in the prod profile -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>

    <!-- ===== tests + test-jar fixtures (consumers declare these as their own test deps) ===== -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security-oidc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- RealmKeycloakResource (test-jar): real Keycloak with the academy realm for bearer-token tests -->
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <configuration>
              <!-- classes loaded by Quarkus are instrumented by quarkus-jacoco into the same data file -->
              <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
              <append>true</append>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <!-- the test-jar ships ONLY reusable fixtures, never this module's own tests, migrations or config -->
            <goals><goal>test-jar</goal></goals>
            <configuration>
              <includes>
                <include>com/hoopsacademy/common/testing/**</include>
                <include>META-INF/beans.xml</include>
                <include>META-INF/services/**</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- just mutation common-quarkus (or -Pmutation): PIT on the rule code above; fails below the recorded baseline -->
    <profile>
      <id>mutation</id>
      <activation>
        <property><name>mutation</name><value>common-quarkus</value></property>
      </activation>
      <properties>
        <pit.skip>false</pit.skip>
        <!-- baseline (docs/quality/mutation.md): 99.5 % (210/211) on 2026-11-07 (WP88), the score rounded down to a whole
             percent -->
        <pit.mutationThreshold>99</pit.mutationThreshold>
      </properties>
    </profile>
  </profiles>
</project>
