<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hoopsacademy</groupId>
    <artifactId>hoops-academy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>contracts</artifactId>
  <packaging>jar</packaging>
  <name>Hoops Academy :: contracts</name>
  <description>OpenAPI 3.0.3 specifications (core, game, athlete) and match-event JSON Schema, shipped as classpath resources</description>

  <properties>
    <!-- Contract-test libraries: versions pinned here on purpose (not managed by the parent). -->
    <swagger-parser.version>2.1.48</swagger-parser.version>
    <!-- 2.0.x is the newest line on Jackson 2 (3.x moved to tools.jackson / Jackson 3). -->
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <assertj.version>3.27.7</assertj.version>
    <contracts.openapi.dir>${project.basedir}/openapi</contracts.openapi.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.swagger.parser.v3</groupId>
      <artifactId>swagger-parser</artifactId>
      <version>${swagger-parser.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The validator the services and e2e use (version managed by the parent): StrictValidatorCompatibilityTest. -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-core</artifactId>
      <version>${openapi-request-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- The contract files live at the module root (scripts/gen-api.sh and humans read them there) and are
         packaged at the jar root, i.e. classpath:openapi/core.yaml, classpath:events/match-event.schema.json. -->
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>openapi/**</include>
          <include>events/**</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- override: this module is not a Quarkus app, so no JBoss LogManager -->
          <systemPropertyVariables combine.self="override">
            <contracts.dir>${project.basedir}</contracts.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <configuration>
          <strictSpec>true</strictSpec>
        </configuration>
        <!-- common.yaml has no operations; its components are validated through the three service specs. -->
        <executions>
          <execution>
            <id>validate-core</id>
            <phase>verify</phase>
            <goals><goal>validate</goal></goals>
            <configuration><inputSpec>${contracts.openapi.dir}/core.yaml</inputSpec></configuration>
          </execution>
          <execution>
            <id>validate-game</id>
            <phase>verify</phase>
            <goals><goal>validate</goal></goals>
            <configuration><inputSpec>${contracts.openapi.dir}/game.yaml</inputSpec></configuration>
          </execution>
          <execution>
            <id>validate-athlete</id>
            <phase>verify</phase>
            <goals><goal>validate</goal></goals>
            <configuration><inputSpec>${contracts.openapi.dir}/athlete.yaml</inputSpec></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
