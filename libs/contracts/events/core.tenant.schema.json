{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoops.academy/contracts/events/core.tenant.schema.json",
  "title": "core.tenant",
  "description": "An academy (tenant): master data and lifecycle status. The aggregate id is the tenant id. Key `<tenantId>:<tenantId>`. Tenants are never deleted: WITHDRAWN is terminal. Envelope common to every core topic (libs/contracts/README.md, section Events): published by core's outbox publisher, at least once, in outbox order per key; consumers ignore a known `eventId` and never let an older `occurredAt` overwrite a newer one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "tenantId",
    "aggregateId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "$ref": "#/$defs/Uuid",
      "description": "Unique per event (the outbox row id); the same id on every redelivery."
    },
    "type": {
      "type": "string",
      "enum": [
        "tenant.changed"
      ]
    },
    "version": {
      "const": 1,
      "description": "Major version of the topic's contract (a breaking change is a new topic `<topic>.v2`)."
    },
    "tenantId": {
      "$ref": "#/$defs/Uuid",
      "description": "The academy the event belongs to; consumers bind it per event."
    },
    "aggregateId": {
      "$ref": "#/$defs/Uuid",
      "description": "Id of the aggregate; the Kafka key is `<tenantId>:<aggregateId>`."
    },
    "occurredAt": {
      "$ref": "#/$defs/Instant",
      "description": "When core wrote the change (UTC)."
    },
    "payload": {
      "$ref": "#/$defs/TenantChanged"
    }
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "TenantChanged": {
      "type": "object",
      "description": "The academy's current state.",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "status",
        "timezone",
        "defaultLocale"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,48}[a-z0-9])$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "WITHDRAWN"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone id, e.g. Europe/Madrid."
        },
        "defaultLocale": {
          "type": "string",
          "enum": [
            "es",
            "en",
            "id"
          ]
        }
      }
    }
  }
}
