{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoops.academy/contracts/events/core.team.schema.json",
  "title": "core.team",
  "description": "A team of an academy with its season's dates (authorisation keeps teams whose season has not ended), so a change of the season's dates emits a `team.changed` for each of its teams. Key `<tenantId>:<teamId>`. Deleting a team emits `team.removed` (empty payload), then a tombstone (null value) for the same key. Envelope common to every core topic (libs/contracts/README.md, section Events): published by core's outbox publisher, at least once, in outbox order per key; consumers ignore a known `eventId` and never let an older `occurredAt` overwrite a newer one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "tenantId",
    "aggregateId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "$ref": "#/$defs/Uuid",
      "description": "Unique per event (the outbox row id); the same id on every redelivery."
    },
    "type": {
      "type": "string",
      "enum": [
        "team.changed",
        "team.removed"
      ]
    },
    "version": {
      "const": 1,
      "description": "Major version of the topic's contract (a breaking change is a new topic `<topic>.v2`)."
    },
    "tenantId": {
      "$ref": "#/$defs/Uuid",
      "description": "The academy the event belongs to; consumers bind it per event."
    },
    "aggregateId": {
      "$ref": "#/$defs/Uuid",
      "description": "Id of the aggregate; the Kafka key is `<tenantId>:<aggregateId>`."
    },
    "occurredAt": {
      "$ref": "#/$defs/Instant",
      "description": "When core wrote the change (UTC)."
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "TeamChanged": {
      "type": "object",
      "description": "The team's current state.",
      "additionalProperties": false,
      "required": [
        "seasonId",
        "seasonStartDate",
        "seasonEndDate",
        "name",
        "alias",
        "ageCategoryId",
        "genderPolicy"
      ],
      "properties": {
        "seasonId": {
          "$ref": "#/$defs/Uuid"
        },
        "seasonStartDate": {
          "$ref": "#/$defs/Date"
        },
        "seasonEndDate": {
          "$ref": "#/$defs/Date"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "alias": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "ageCategoryId": {
          "$ref": "#/$defs/Uuid"
        },
        "genderPolicy": {
          "type": "string",
          "enum": [
            "MALE",
            "FEMALE",
            "MIXED"
          ]
        }
      }
    },
    "TeamRemoved": {
      "type": "object",
      "description": "The team that was deleted: the aggregate id is its identity, nothing else is sent.",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "team.changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TeamChanged"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "team.removed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TeamRemoved"
          }
        }
      }
    }
  ]
}
