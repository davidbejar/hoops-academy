{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoops.academy/contracts/events/core.team-staff.schema.json",
  "title": "core.team-staff",
  "description": "A coach or assistant coach of a team. The aggregate id is derived (the table is keyed by team and person): the name-based (version 3) UUID of the UTF-8 bytes of `team-staff:<teamId>:<personId>` (Java `UUID.nameUUIDFromBytes`). Key `<tenantId>:<aggregateId>`. Detaching emits `team-staff.removed`, then a tombstone (null value) for the same key. Envelope common to every core topic (libs/contracts/README.md, section Events): published by core's outbox publisher, at least once, in outbox order per key; consumers ignore a known `eventId` and never let an older `occurredAt` overwrite a newer one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "tenantId",
    "aggregateId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "$ref": "#/$defs/Uuid",
      "description": "Unique per event (the outbox row id); the same id on every redelivery."
    },
    "type": {
      "type": "string",
      "enum": [
        "team-staff.changed",
        "team-staff.removed"
      ]
    },
    "version": {
      "const": 1,
      "description": "Major version of the topic's contract (a breaking change is a new topic `<topic>.v2`)."
    },
    "tenantId": {
      "$ref": "#/$defs/Uuid",
      "description": "The academy the event belongs to; consumers bind it per event."
    },
    "aggregateId": {
      "$ref": "#/$defs/Uuid",
      "description": "Id of the aggregate; the Kafka key is `<tenantId>:<aggregateId>`."
    },
    "occurredAt": {
      "$ref": "#/$defs/Instant",
      "description": "When core wrote the change (UTC)."
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "TeamStaffChanged": {
      "type": "object",
      "description": "The staff entry's current state.",
      "additionalProperties": false,
      "required": [
        "teamId",
        "personId",
        "role",
        "since"
      ],
      "properties": {
        "teamId": {
          "$ref": "#/$defs/Uuid"
        },
        "personId": {
          "$ref": "#/$defs/Uuid"
        },
        "role": {
          "type": "string",
          "enum": [
            "COACH",
            "ASSISTANT_COACH"
          ]
        },
        "since": {
          "$ref": "#/$defs/Date"
        }
      }
    },
    "TeamStaffRemoved": {
      "type": "object",
      "description": "The staff entry that was detached (identity only).",
      "additionalProperties": false,
      "required": [
        "teamId",
        "personId"
      ],
      "properties": {
        "teamId": {
          "$ref": "#/$defs/Uuid"
        },
        "personId": {
          "$ref": "#/$defs/Uuid"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "team-staff.changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TeamStaffChanged"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "team-staff.removed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TeamStaffRemoved"
          }
        }
      }
    }
  ]
}
